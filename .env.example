# Copy this file to .env and edit.  Never commit .env to Git.

# "mock" = built-in fake SAP (no SAP system needed)   "live" = real S/4HANA tenant
SAP_MODE=mock

# --- live mode only ---------------------------------------------------
# Host only, e.g. https://myXXXXXX-api.s4hana.cloud.sap  (path is added automatically)
SAP_BASE_URL=
# Communication user from your communication arrangement
SAP_USER=
SAP_PASSWORD=
# Plant → business partner that holds the plant address & GSTIN
PLANT_TO_BP={"1000": "10000001", "2000": "10000002"}

# --- app ----------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
COMPANY_NAME=Apex Precision Components Pvt Ltd
COMPANY_SHORT=APEX
GST_RATE=18
PORT=5000
